{
    "name": "oeltimacreation/php-simplequery",
    "description": "A small, framework-agnostic PDO query builder with deterministic SQL compilation",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "database",
        "mariadb",
        "mysql",
        "pdo",
        "query-builder",
        "sqlite"
    ],
    "authors": [
        {
            "name": "Gema Aji Wardian",
            "email": "gema@oeltimacreation.com"
        }
    ],
    "homepage": "https://github.com/oeltimacreation/php-simplequery",
    "support": {
        "issues": "https://github.com/oeltimacreation/php-simplequery/issues",
        "source": "https://github.com/oeltimacreation/php-simplequery"
    },
    "require": {
        "php": "^8.2",
        "ext-pdo": "*"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.0",
        "slevomat/coding-standard": "^8.22",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Oeltima\\SimpleQuery\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Oeltima\\SimpleQuery\\Benchmark\\": "benchmarks/",
            "Oeltima\\SimpleQuery\\Tests\\": "tests/",
            "Oeltima\\SimpleQuery\\Tools\\DatabaseProbe\\": "tools/database-probes/src/",
            "Oeltima\\SimpleQuery\\Tools\\Quality\\": "tools/quality/"
        }
    },
    "scripts": {
        "test": "phpunit --no-coverage",
        "test:coverage": "php scripts/run-coverage.php",
        "test:coverage:branch": "php scripts/run-branch-coverage.php",
        "coverage:check": "php scripts/check-coverage.php coverage/clover.xml --line=90 --compiler-line=95",
        "coverage:check:branch": "php scripts/check-coverage.php coverage/xdebug-clover.xml --line=90 --branch=80 --compiler-line=95 --compiler-branch=90",
        "phpstan": "phpstan analyse --no-progress",
        "phpstan:consumer": "phpstan analyse --no-progress --configuration=phpstan.consumer.neon",
        "cs:check": "phpcs",
        "cs:fix": "phpcbf",
        "docs:check": "php scripts/check-documentation-links.php",
        "lint": "php scripts/lint-php.php",
        "platform:check": "composer check-platform-reqs",
        "public-api:check": "php scripts/public-api-manifest.php",
        "public-api:update": "php scripts/public-api-manifest.php --write",
        "probe:sqlite": "php tools/database-probes/run.php sqlite",
        "probe:sqlite:contention": "php tools/database-probes/run.php sqlite-contention",
        "probe:execution": "php tools/database-probes/execution-smoke.php",
        "probe:transaction": "php tools/database-probes/transaction-smoke.php",
        "benchmark": "php benchmarks/run.php --suite=ci",
        "benchmark:soak": "php benchmarks/run.php --suite=soak --profile=reference --iterations=7 --warmups=2",
        "examples:check": [
            "php examples/beginner/first-query.php",
            "php examples/beginner/filter-and-update.php",
            "php examples/beginner/transaction.php",
            "php examples/compiler-assertions.php",
            "php examples/query-building.php",
            "php examples/sqlite-compiler-smoke.php",
            "php examples/sqlite-execution.php",
            "php examples/sqlite-streaming-report.php",
            "php examples/sqlite-batch-write.php",
            "php examples/sqlite-transactions.php",
            "php examples/sqlite-migration-slice.php"
        ],
        "release:check": "php scripts/check-release-consistency.php",
        "verify": "php scripts/verify-repository.php",
        "check": [
            "@lint",
            "@platform:check",
            "@test",
            "@phpstan",
            "@phpstan:consumer",
            "@cs:check",
            "@public-api:check",
            "@docs:check",
            "@examples:check",
            "@release:check",
            "@verify"
        ],
        "package:check": "php scripts/check-package.php"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "archive": {
        "exclude": [
            "/*",
            "/.*",
            "!/src/",
            "!/docs/",
            "!/examples/",
            "!/composer.json",
            "!/LICENSE",
            "!/README.md",
            "!/CHANGELOG.md",
            "!/CONTRIBUTING.md",
            "!/SECURITY.md",
            "!/SUPPORT.md",
            "**/.env",
            "**/.env.*",
            "**/vendor/",
            "**/.cache/",
            "**/coverage/"
        ]
    }
}
