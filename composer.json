{
    "name": "oeltimacreation/php-simplequery",
    "description": "A small, framework-agnostic PDO query builder with deterministic SQL compilation",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "database",
        "mariadb",
        "mysql",
        "pdo",
        "query-builder",
        "sqlite"
    ],
    "authors": [
        {
            "name": "Gema Aji Wardian",
            "email": "gema@oeltimacreation.com"
        }
    ],
    "homepage": "https://github.com/oeltimacreation/php-simplequery",
    "support": {
        "issues": "https://github.com/oeltimacreation/php-simplequery/issues",
        "source": "https://github.com/oeltimacreation/php-simplequery"
    },
    "require": {
        "php": "^8.2",
        "ext-pdo": "*"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.0",
        "slevomat/coding-standard": "^8.22",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Oeltima\\SimpleQuery\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Oeltima\\SimpleQuery\\Tests\\": "tests/",
            "Oeltima\\SimpleQuery\\Tools\\DatabaseProbe\\": "tools/database-probes/src/"
        }
    },
    "scripts": {
        "test": "phpunit --no-coverage",
        "test:coverage": "php scripts/run-coverage.php",
        "coverage:check": "php scripts/check-coverage.php coverage/clover.xml --line=90 --branch=80 --compiler-line=95 --compiler-branch=90",
        "phpstan": "phpstan analyse --no-progress",
        "cs:check": "phpcs",
        "cs:fix": "phpcbf",
        "lint": "php scripts/lint-php.php",
        "probe:sqlite": "php tools/database-probes/run.php sqlite",
        "probe:matrix": "php tools/database-probes/run-matrix.php",
        "benchmark": "php benchmarks/run.php",
        "examples:check": [
            "php examples/compiler-assertions.php",
            "php examples/query-building.php",
            "php examples/sqlite-compiler-smoke.php"
        ],
        "verify": "php scripts/verify-repository.php",
        "check": [
            "@lint",
            "@test",
            "@phpstan",
            "@cs:check",
            "@examples:check",
            "@verify"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "archive": {
        "exclude": [
            "/.github/",
            "/benchmarks/",
            "/tests/",
            "/tools/"
        ]
    }
}
