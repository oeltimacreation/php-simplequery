# Synthetic single-backend MaxScale fixture.
[mariadb-primary]
type=server
address=mariadb
port=3306
protocol=MariaDBBackend

[mariadb-monitor]
type=monitor
module=mariadbmon
servers=mariadb-primary
user=simplequery_monitor
password=simplequery-monitor
monitor_interval=2s

[simplequery-service]
type=service
router=readwritesplit
servers=mariadb-primary
user=simplequery_maxscale
password=simplequery-maxscale
transaction_replay=false
delayed_retry=false
master_accept_reads=true

[simplequery-listener]
type=listener
service=simplequery-service
protocol=MariaDBClient
port=4006
address=0.0.0.0
